# Archivos bajados o generados al usar la app (se recrean solos)
descargas/
datos/catalogo.json
datos/musica-cache.json
datos/youtube-titulos.json

# Datos propios de cada instalación
datos/favoritos.json
datos/mis-meditaciones.json
datos/mis-letras.json

# Audios pesados que se copian a mano
musica-fondo/

# Temporales de escritura
*.tmp
*.part

# Configuración local de herramientas
.claude/

# Datos personales de los miembros (no subir)
datos/cumpleanos.json
datos/roles.json
datos/fotos/
datos/lideres.json

# Apps de Android compiladas (llevan datos personales)
*.apk
datos/sincronizacion.json
