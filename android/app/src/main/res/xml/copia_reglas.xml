<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o más nuevo: qué se respalda en la cuenta de Google y qué pasa al cambiar de celular.
     Se respaldan los datos personales (favoritos, meditaciones y letras propias, ajustes);
     no los audios ni imágenes descargados, que pesan mucho y se vuelven a bajar solos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datos/" />
        <include domain="sharedpref" path="." />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <exclude domain="file" path="descargas/" />
        <exclude domain="file" path="datos/fotos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datos/" />
        <include domain="sharedpref" path="." />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <exclude domain="file" path="descargas/" />
    </device-transfer>
</data-extraction-rules>
